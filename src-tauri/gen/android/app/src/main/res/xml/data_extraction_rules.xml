<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune donnée de l'application n'est copiée dans la sauvegarde cloud ni lors
     d'un transfert vers un nouvel appareil. La sauvegarde passe uniquement par l'export JSON. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
